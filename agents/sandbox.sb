;; macOS Seatbelt profile applied to every agent process and its children.
;; The runner substitutes @RUN_DIR@ (the per-run directory holding the fresh
;; home, which contains the working directory, and the temp dir),
;; @READ_ONLY_PATHS@ (the agent's install/runtime paths), and @EXTRA_RULES@
;; (condition-specific rules, e.g., blocking a command's binaries).
;; Contents of /Users, /Volumes and the shared temp dirs are unreadable except
;; for the run's own directory, so agents cannot see this repo, other runs, or
;; the real home directory. File metadata (stat) stays allowed so path
;; resolution works. Writes are only allowed inside the run's directory, so
;; agents cannot change the machine, e.g., by installing software globally.
;; Note: allow rules must name the same operation as the deny they override.
(version 1)
(allow default)
(deny file-read-data
  (subpath "/Users")
  (subpath "/Volumes")
  (subpath "/private/tmp")
  (subpath "/private/var/folders"))
(deny file-write*
  (subpath "/"))
(allow file-read-data file-write*
  (subpath "@RUN_DIR@"))
(allow file-write*
  (subpath "/dev"))
;; Apple's xcrun shims (e.g., /usr/bin/python3) cache to the per-user temp
;; dir regardless of TMPDIR and print errors when they can't
(allow file-read-data file-write*
  (regex #"^/private/var/folders/[^/]+/[^/]+/T/xcrun_db"))
(allow file-read-data
  @READ_ONLY_PATHS@)
@EXTRA_RULES@
