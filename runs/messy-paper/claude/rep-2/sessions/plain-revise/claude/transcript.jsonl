{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JcaB8Kp1MFw3cYLobMnKLD","type":"tool_result","content":"# Reproduces every number, table and figure in paper/draft.md from the raw data.\n# Run from the project root:  python paper/paper_analysis.py\n#\n# Differences from process.py / process_b3.py / analysis.ipynb:\n#   - one script for both DAQ formats; sensitivity fitted from each calibration file\n#   - nu and rho evaluated at the logged water temperature of each run (was 20 C)\n#   - runs flagged by a post-run zero-shift criterion are excluded (run 17)\n#   - adds uncertainty, Strouhal number, Froude number and a blockage sensitivity check\nimport glob\nimport os\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\n\nOUT = \"paper\"\nos.makedirs(f\"{OUT}/figures\", exist_ok=True)\n\nG = 9.81\nL = 0.60                      # submerged length (m)\nTANK_W, TANK_H = 0.90, 0.75   # tank cross-section (m)\nT_TARE = 1.0                  # tare window: t < 1 s\nWIN = (3.0, 8.0)              # steady averaging window (s)\nZERO_SHIFT_MAX = 0.05         # N; exclusion threshold on |post-run zero - pre-run zero|\n\n# assumed (placeholder) standard uncertainties -- CONFIRM WITH AUTHORS\nU_REL_SPEED = 0.005   # carriage speed, relative\nU_D = 0.05e-3         # diameter, m\nU_L = 2e-3            # submerged length, m\n\nCAL = {\"2025-09\": \"data/calibration/loadcell_2025-09.csv\",\n       \"2026-03\": \"data/calibration/loadcell_2026-03.csv\"}\nBATCH_CAL = {\"2025-10-14\": \"2025-09\", \"2025-11-03\": \"2025-09\", \"2026-03-12\": \"2026-03\"}\n\n\ndef water_rho(T):\n    \"\"\"Density of pure water (kg/m^3), Tanaka et al. (2001) form.\"\"\"\n    return 999.974950 * (1 - (T - 3.983035) ** 2 * (T + 301.797)\n                         / (522528.9 * (T + 69.34881)))\n\n\ndef water_mu(T):\n    \"\"\"Dynamic viscosity of water (Pa s), Vogel equation.\"\"\"\n    return 2.414e-5 * 10 ** (247.8 / (T + 273.15 - 140.0))\n\n\ndef fit_cal(path):\n    c = pd.read_csv(path)\n    x = c.mass_g / 1000 * G\n    p, cov = np.polyfit(x, c.voltage_V, 1, cov=True)\n    resid = c.voltage_V - np.polyval(p, x)\n    return dict(sens=p[0], sens_se=np.sqrt(cov[0, 0]), offset=p[1],\n                max_resid_N=resid.abs().max() / p[0], n=len(c))\n\n\ndef read_run(path):\n    if \"2026-03\" in path:\n        d = pd.read_csv(path, sep=\";\")\n        return d.t.values, d.V.values\n    d = pd.read_csv(path, comment=\"#\")\n    return d.time_s.values, d.loadcell_V.values\n\n\ndef shedding_freq(F, fs):\n    \"\"\"Dominant drag-fluctuation frequency (Hann window, 16x zero-padding).\"\"\"\n    x = (F - F.mean()) * np.hanning(len(F))\n    n = 16 * len(x)\n    spec = np.abs(np.fft.rfft(x, n))\n    f = np.fft.rfftfreq(n, 1 / fs)\n    sel = f > 0.5\n    return f[sel][np.argmax(spec[sel])]\n\n\ncals = {k: fit_cal(v) for k, v in CAL.items()}\nlog = pd.read_csv(\"data/run_log.csv\")\n\nrows = []\nfor path in sorted(glob.glob(\"data/raw/*/run_*.csv\")):\n    batch = path.split(os.sep)[-2]\n    cal = cals[BATCH_CAL[batch]]\n    t, v = read_run(path)\n    fs = 1 / np.median(np.diff(t))\n    zero_pre = v[t < T_TARE].mean()\n    zero_post = v[t > t.max() - T_TARE].mean()\n    F = (v - zero_pre) / cal[\"sens\"]\n    w = (t > WIN[0]) & (t < WIN[1])\n    Fw = F[w]\n    # precision of the mean from five 1-s block means\n    blocks = np.array_split(Fw, 5)\n    bm = np.array([b.mean() for b in blocks])\n    rows.append(dict(run=int(os.path.basename(path)[4:7]), batch=batch,\n                     F=Fw.mean(), F_rms=Fw.std(), F_se=bm.std(ddof=1) / np.sqrt(len(bm)),\n                     sens=cal[\"sens\"], sens_rel=cal[\"sens_se\"] / cal[\"sens\"],\n                     zero_shift_N=(zero_post - zero_pre) / cal[\"sens\"],\n                     f_drag=shedding_freq(Fw, fs)))\n\ndf = pd.DataFrame(rows).merge(log, left_on=\"run\", right_on=\"run_id\")\nD = df.diameter_mm / 1000\nU = df.speed_m_s\nT = df.water_temp_c\ndf[\"rho\"] = water_rho(T)\ndf[\"nu\"] = water_mu(T) / df.rho\ndf[\"Re\"] = U * D / df.nu\ndf[\"Re_20C\"] = U * D / 1.004e-6\ndf[\"Fr_D\"] = U / np.sqrt(G * D)\ndf[\"LD\"] = L / D\nq = 0.5 * df.rho * U ** 2 * D * L\ndf[\"Cd\"] = df.F / q\ndf[\"Cd_rms\"] = df.F_rms / q\ndf[\"St\"] = (df.f_drag / 2) * D / U         # drag fluctuates at twice the shedding frequency\ndf[\"blockage\"] = D * L / (TANK_W * TANK_H)\n# blockage sensitivity: Maskell-type correction, theta = 2.5 (upper) and simple (1-B)^2 (lower)\ndf[\"Cd_maskell\"] = df.Cd / (1 + 2.5 * df.Cd * df.blockage)\ndf[\"Cd_simple\"] = df.Cd * (1 - df.blockage) ** 2\n# uncertainty in Cd (root-sum-square of relative terms)\ndf[\"u_Cd_rel\"] = np.sqrt((df.F_se / df.F) ** 2 + df.sens_rel ** 2 + (2 * U_REL_SPEED) ** 2\n                         + (U_D / D) ** 2 + (U_L / L) ** 2)\ndf[\"u_Cd\"] = df.u_Cd_rel * df.Cd\ndf[\"excluded\"] = df.zero_shift_N.abs() > ZERO_SHIFT_MAX\n\ngood = df[~df.excluded]\norder = [\"1in\", \"1.5in\", \"2in\"]\n\n# ---------------------------------------------------------------- printed summary\nprint(\"Calibration\")\nfor k, c in cals.items():\n    print(f\"  {k}: sens = {c['sens']:.5f} V/N (SE {c['sens_se']/c['sens']*100:.2f}%), \"\n          f\"max residual {c['max_resid_N']*1000:.1f} mN, n = {c['n']}\")\nprint(f\"  sensitivity change between calibrations: \"\n      f\"{(cals['2026-03']['sens']/cals['2025-09']['sens']-1)*100:+.1f}%\")\n\nprint(\"\\nZero shift (N): max |shift| among retained runs = \"\n      f\"{good.zero_shift_N.abs().max():.4f}; excluded runs:\")\nprint(df.loc[df.excluded, [\"run\", \"cylinder\", \"speed_m_s\", \"zero_shift_N\", \"Cd\"]].round(4).to_string(index=False))\n\nprint(\"\\nRe range per cylinder (temperature-corrected) and ratio to 20 C value\")\nprint(good.groupby(\"cylinder\").agg(Re_min=(\"Re\", \"min\"), Re_max=(\"Re\", \"max\"),\n      T_mean=(\"water_temp_c\", \"mean\"), Re20_over_Re=(\"Re_20C\", lambda s: 0)).loc[order].round(0))\nprint(\"  Re_20C/Re ratio range:\", (good.Re_20C / good.Re).min().round(3), \"-\", (good.Re_20C / good.Re).max().round(3))\n\nsumm = good.groupby(\"cylinder\").agg(\n    n=(\"Cd\", \"size\"), D_mm=(\"diameter_mm\", \"first\"), LD=(\"LD\", \"first\"),\n    B_pct=(\"blockage\", lambda s: 100 * s.iloc[0]),\n    Cd_mean=(\"Cd\", \"mean\"), Cd_sd=(\"Cd\", \"std\"),\n    Cd_simple=(\"Cd_simple\", \"mean\"), Cd_maskell=(\"Cd_maskell\", \"mean\"),\n    St_mean=(\"St\", \"mean\"), St_sd=(\"St\", \"std\"), Cdrms_mean=(\"Cd_rms\", \"mean\"),\n    u_rel_pct=(\"u_Cd_rel\", lambda s: 100 * s.mean())).loc[order]\nprint(\"\\nPer-cylinder summary (run 17 excluded)\")\nprint(summ.round(3).to_string())\nprint(f\"\\nAll retained runs: n = {len(good)}, Cd = {good.Cd.mean():.3f} +/- {good.Cd.std():.3f} (sd), \"\n      f\"St = {good.St.mean():.3f} +/- {good.St.std():.3f}\")\nprint(\"Notebook values incl. run 17, 20 C:  2in mean Cd =\",\n      round(df[df.cylinder == '2in'].Cd.mean(), 3))\n\n# trend tests\nfor name, x in [(\"log10 Re\", np.log10(good.Re)), (\"Fr_D\", good.Fr_D)]:\n    p, cov = np.polyfit(x, good.Cd, 1, cov=True)\n    r = np.corrcoef(x, good.Cd)[0, 1]\n    print(f\"Cd vs {name}: slope {p[0]:.3f} +/- {np.sqrt(cov[0,0]):.3f}, r = {r:.2f}\")\n# does Cd depend on D at matched Re?  Compare at shared Re values via a regression Cd ~ logRe + D\nX = np.column_stack([np.ones(len(good)), np.log10(good.Re), good.diameter_mm])\nbeta, res, *_ = np.linalg.lstsq(X, good.Cd, rcond=None)\nsig2 = res[0] / (len(good) - 3)\nse = np.sqrt(np.diag(sig2 * np.linalg.inv(X.T @ X)))\nprint(f\"Cd ~ a + b log10Re + c D[mm]: b = {beta[1]:.3f} +/- {se[1]:.3f}, c = {beta[2]*25.4:.3f} +/- {se[2]*25.4:.3f} per inch\")\nprint(f\"Run-to-run residual sd about the 2-term fit: {np.sqrt(sig2):.3f}\")\nprint(f\"Mean estimated u(Cd)/Cd: {good.u_Cd_rel.mean()*100:.2f}%  \"\n      f\"(force-mean precision alone: {(good.F_se/good.F).mean()*100:.2f}%)\")\nprint(\"Fr_D range:\", good.Fr_D.min().round(2), \"-\", good.Fr_D.max().round(2))\nprint(\"Cd_rms/Cd range:\", (good.Cd_rms / good.Cd).min().round(3), \"-\", (good.Cd_rms / good.Cd).max().round(3))\n\n# ---------------------------------------------------------------- tables\ntab = df[[\"run\", \"cylinder\", \"diameter_mm\", \"speed_m_s\", \"water_temp_c\", \"Re\", \"Fr_D\",\n          \"F\", \"Cd\", \"u_Cd\", \"Cd_rms\", \"St\", \"zero_shift_N\", \"excluded\"]].copy()\ntab.to_csv(f\"{OUT}/results_by_run.csv\", index=False, float_format=\"%.5g\")\nsumm.to_csv(f\"{OUT}/results_by_cylinder.csv\", float_format=\"%.4g\")\n\n# ---------------------------------------------------------------- figures\nCOL = {\"1in\": \"#2a78d6\", \"1.5in\": \"#eb6834\", \"2in\": \"#1baf7a\"}\nMRK = {\"1in\": \"o\", \"1.5in\": \"s\", \"2in\": \"^\"}\nLAB = {\"1in\": \"D = 25.4 mm\", \"1.5in\": \"D = 38.1 mm\", \"2in\": \"D = 50.8 mm\"}\nplt.rcParams.update({\"font.size\": 9, \"axes.spines.top\": False, \"axes.spines.right\": False,\n                     \"axes.edgecolor\": \"#555\", \"axes.labelcolor\": \"#222\",\n                     \"xtick.color\": \"#555\", \"ytick.color\": \"#555\"})\n\n\ndef style(ax):\n    ax.grid(True, which=\"major\", color=\"#e6e6e6\", lw=0.6)\n    ax.set_axisbelow(True)\n\n\n# Fig 2: Cd vs Re\nfig, ax = plt.subplots(figsize=(5.0, 3.4))\nfor cyl in order:\n    g = good[good.cylinder == cyl]\n    ax.errorbar(g.Re, g.Cd, yerr=g.u_Cd, fmt=MRK[cyl], ms=5, color=COL[cyl], mec=\"white\",\n                mew=0.6, elinewidth=0.8, capsize=0, label=LAB[cyl])\nex = df[df.excluded]\nax.plot(ex.Re, ex.Cd, \"x\", color=\"#888\", ms=6, label=\"run 17 (excluded)\")\nax.set_xscale(\"log\")\nax.set_xlabel(\"Re = UD/ν\")\nax.set_ylabel(\"$C_D$\")\nstyle(ax)\nax.legend(frameon=False, fontsize=8, loc=\"upper left\")\nfig.tight_layout()\nfig.savefig(f\"{OUT}/figures/fig2_cd_vs_re.png\", dpi=300)\nfig.savefig(f\"{OUT}/figures/fig2_cd_vs_re.pdf\")\n\n# Fig 1: example force record\nt, v = read_run(\"data/raw/2025-10-14/run_005.csv\")\nF = (v - v[t < T_TARE].mean()) / cals[\"2025-09\"][\"sens\"]\nfig, ax = plt.subplots(figsize=(5.0, 2.6))\nax.axvspan(*WIN, color=\"#eeeeee\", lw=0)\nax.plot(t, F, lw=0.5, color=COL[\"1in\"])\nax.axhline(F[(t > WIN[0]) & (t < WIN[1])].mean(), color=\"#222\", lw=0.8, ls=\"--\")\nax.text(5.5, 0.4, \"averaging window\", ha=\"center\", fontsize=8, color=\"#555\")\nax.set_xlabel(\"t (s)\")\nax.set_ylabel(\"F (N)\")\nstyle(ax)\nfig.tight_layout()\nfig.savefig(f\"{OUT}/figures/fig1_timeseries_run005.png\", dpi=300)\nfig.savefig(f\"{OUT}/figures/fig1_timeseries_run005.pdf\")\n\n# Fig 3: Strouhal number and Cd vs Froude number (two panels, separate y axes)\nfig, axs = plt.subplots(1, 2, figsize=(7.0, 2.9))\nfor cyl in order:\n    g = good[good.cylinder == cyl]\n    axs[0].plot(g.Re, g.St, MRK[cyl], ms=5, color=COL[cyl], mec=\"white\", mew=0.6, label=LAB[cyl])\n    axs[1].plot(g.Fr_D, g.Cd, MRK[cyl], ms=5, color=COL[cyl], mec=\"white\", mew=0.6, label=LAB[cyl])\naxs[0].set_xscale(\"log\"); axs[0].set_xlabel(\"Re\"); axs[0].set_ylabel(\"St = $f_s D/U$\")\naxs[0].set_ylim(0.15, 0.25)\naxs[1].set_xlabel(\"$Fr_D = U/\\\\sqrt{gD}$\"); axs[1].set_ylabel(\"$C_D$\")\nfor a, lbl in zip(axs, \"ab\"):\n    style(a)\n    a.text(-0.2, 1.02, f\"({lbl})\", transform=a.transAxes, fontsize=9)\naxs[1].legend(frameon=False, fontsize=8)\nfig.tight_layout()\nfig.savefig(f\"{OUT}/figures/fig3_st_and_froude.png\", dpi=300)\nfig.savefig(f\"{OUT}/figures/fig3_st_and_froude.pdf\")\nprint(\"\\nwrote\", OUT)\n.:\ntotal 488\ndrwxr-xr-x@  8 pete  wheel     256 Oct 30 07:22 .\ndrwxr-xr-x@ 14 pete  wheel     448 Oct 30 07:20 ..\n-rw-r--r--@  1 pete  wheel  205207 Oct 30 07:22 draft.docx\n-rw-r--r--@  1 pete  wheel   18697 Oct 30 07:22 draft.md\ndrwxr-xr-x@  8 pete  wheel     256 Oct 30 07:20 figures\n-rw-r--r--@  1 pete  wheel   10687 Oct 30 07:20 paper_analysis.py\n-rw-r--r--@  1 pete  wheel     333 Oct 30 07:20 results_by_cylinder.csv\n-rw-r--r--@  1 pete  wheel    2821 Oct 30 07:20 results_by_run.csv\n\nfigures:\ntotal 544\ndrwxr-xr-x@ 8 